{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    // Node 22.18+/24 runs TypeScript directly via type stripping, which
    // requires imports to carry the real .ts extension. Playwright resolves
    // those too, so one import style works for both runtimes.
    "allowImportingTsExtensions": true
  },
  "include": ["config/**/*.ts", "db/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "*.ts"],
  "exclude": ["node_modules", ".qa-build", "qa-artifacts"]
}
