# ---------------------------------------------------------------------------
# crm_qa environment template
#
# Copy to .env.qa.local and fill in real values. .env.qa.local is gitignored
# and must never be committed. This file contains PLACEHOLDERS ONLY.
# ---------------------------------------------------------------------------

# --- Target application working copies -------------------------------------
# Paths to the frontend and backend checkouts the harness should drive.
CRM_FRONTEND_PATH=../crm_frontend
CRM_BACKEND_PATH=../crm_backend

# --- QA server ports -------------------------------------------------------
# Deliberately offset from the normal dev ports (3000/4000) so a QA run can
# never collide with a running development instance.
QA_FRONTEND_PORT=3100
QA_BACKEND_PORT=4100
QA_BASE_URL=http://localhost:3100

# --- QA database -----------------------------------------------------------
# QA_DB_NAME must match the database inside QA_DATABASE_URL exactly, and must
# match /^crm_qa(_[a-z0-9_]+)?$/. The destructive-operation guard enforces
# both and refuses to run otherwise.
QA_DB_NAME=crm_qa
QA_DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/crm_qa

# Superuser connection used ONLY for CREATE DATABASE / DROP DATABASE.
# Must point at the "postgres" maintenance database, never an app database.
# The application role typically lacks CREATEDB, which is why this is separate.
QA_ADMIN_DATABASE_URL=postgresql://<superuser>@localhost:5432/postgres

# --- QA backend secrets ----------------------------------------------------
# QA-only. Unrelated to any development or production secret. Any random
# high-entropy string works; it only ever signs throwaway QA sessions.
QA_JWT_SECRET=<generate-a-random-64-char-hex-string>

# --- QA test accounts ------------------------------------------------------
# Created by the deterministic seed inside the crm_qa database only.
# The owner role is required to exercise the full navigation (Users,
# Automation) and team-wide visibility.
QA_OWNER_EMAIL=qa-owner@crm.local
QA_OWNER_PASSWORD=<generate-a-random-password>

# Reserved for Phase 3 (RBAC / restricted-navigation coverage). Unused today.
QA_AGENT_EMAIL=qa-agent@crm.local
QA_AGENT_PASSWORD=<generate-a-random-password>

# --- Behaviour flags -------------------------------------------------------
# build = production build from an isolated staged copy (required for
#         representative Lighthouse numbers in Phase 5)
QA_FRONTEND_MODE=build

# Pinned-ref checkout. Not implemented until Phase 6; setting this to 1
# currently raises an explicit "not implemented" error.
QA_ISOLATED_WORKSPACE=0
